{
  "name": "doomparfum-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=24.0.0 <25", "npm": ">=11.0.0 <12" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "validate:fixtures": "node scripts/validate-fixtures.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "npm run validate:fixtures",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "typecheck:gen": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "scan:output": "node scripts/scan-output.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
